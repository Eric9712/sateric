---
import ProductCard from './ProductCard.astro';
import type { SiteData } from '../types';
import { productRedirectSlug, nestedItemId } from '../lib/redirectSlug.mjs';

interface Product {
  title: string;
  badge?: string;
  price: number;
  originalPrice?: number | null;
  image: string;
  affiliateUrl: string;
  isStarterProduct?: boolean;
}

interface ListData {
  title: string;
  tabLabel?: string;
  icon?: string;
  description?: string;
  products: Product[];
  subIdeas: { title: string; products: Product[] }[];
}

interface Props {
  site: SiteData;
  vitrineId: string;
  lists: ListData[];
}

const { site, vitrineId, lists } = Astro.props;
// Identifiant stable par liste (pour les ids DOM et les liens /aller/...),
// dérivé du titre. Les listes n'ont plus leur propre fichier depuis le
// passage aux vitrines : leur ordre d'affichage suit directement l'ordre
// dans lequel elles sont rangées dans l'éditeur (glisser-déposer).
const listIds = lists.map((list, i) => nestedItemId(vitrineId, i, list.title));
---

<section aria-labelledby="idea-lists-heading" class="px-4 py-6">
  <div class="max-w-xl lg:max-w-5xl mx-auto rounded-3xl bg-white p-4 lg:p-6 shadow-sm ring-1 ring-black/5">
    <h2 id="idea-lists-heading" class="mb-3 flex items-center gap-2 text-lg font-extrabold text-ink-900">
      <span class="h-5 w-1.5 rounded-full bg-gradient-to-b from-brand-500 to-accent-500" aria-hidden="true" />
      {site.uiText.ideaListsHeading}
    </h2>

    <div role="tablist" aria-label="Listes thématiques" class="flex flex-wrap gap-2">
      {
        lists.map((list, i) => (
          <button
            type="button"
            role="tab"
            id={`tab-${listIds[i]}`}
            aria-controls={`panel-${listIds[i]}`}
            aria-selected={i === 0 ? 'true' : 'false'}
            tabindex={i === 0 ? 0 : -1}
            data-tab-trigger
            data-active={i === 0 ? 'true' : 'false'}
            class="tap-target whitespace-nowrap rounded-full border border-neutral-200 bg-white px-4 text-sm font-semibold text-ink-900 shadow-sm transition-all data-[active=true]:border-transparent data-[active=true]:bg-gradient-to-r data-[active=true]:from-brand-600 data-[active=true]:to-accent-600 data-[active=true]:text-white data-[active=true]:shadow-md data-[active=true]:scale-[1.03]"
          >
            {list.icon} {list.tabLabel || list.title}
          </button>
        ))
      }
    </div>

    {
      lists.map((list, i) => (
        <div role="tabpanel" id={`panel-${listIds[i]}`} aria-labelledby={`tab-${listIds[i]}`} hidden={i !== 0} class="pt-4">
          <div class="mb-3">
            <p class="text-sm text-neutral-500">{list.title}</p>
            {list.description && <p class="mt-0.5 text-xs text-neutral-400">{list.description}</p>}
          </div>

          {list.subIdeas.length > 0 ? (
            <div class="flex flex-col gap-6">
              {list.subIdeas.map((subIdea) => (
                <div>
                  <h3 class="mb-2 flex items-center gap-1.5 text-sm font-bold text-ink-900">
                    <span class="h-3.5 w-1 rounded-full bg-accent-500" aria-hidden="true" />
                    {subIdea.title}
                  </h3>
                  <div class="grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-4 lg:gap-4">
                    {subIdea.products.map((product) => (
                      <ProductCard
                        site={site}
                        title={product.title}
                        badge={product.badge}
                        price={product.price}
                        originalPrice={product.originalPrice}
                        image={product.image}
                        affiliateUrl={`/aller/${productRedirectSlug(listIds[i], product.title)}`}
                        listTitle={`${list.title} — ${subIdea.title}`}
                        isStarterProduct={product.isStarterProduct}
                      />
                    ))}
                  </div>
                </div>
              ))}
            </div>
          ) : (
            <div class="grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-4 lg:gap-4">
              {list.products.map((product) => (
                <ProductCard
                  site={site}
                  title={product.title}
                  badge={product.badge}
                  price={product.price}
                  originalPrice={product.originalPrice}
                  image={product.image}
                  affiliateUrl={`/aller/${productRedirectSlug(listIds[i], product.title)}`}
                  listTitle={list.title}
                  isStarterProduct={product.isStarterProduct}
                />
              ))}
            </div>
          )}
        </div>
      ))
    }
  </div>
</section>

<script>
  const triggers = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-tab-trigger]'));
  const panels = Array.from(document.querySelectorAll<HTMLElement>('[role="tabpanel"]'));

  function activate(index: number) {
    triggers.forEach((trigger, i) => {
      const active = i === index;
      trigger.setAttribute('aria-selected', String(active));
      trigger.dataset.active = String(active);
      trigger.tabIndex = active ? 0 : -1;
      if (panels[i]) panels[i].hidden = !active;
    });
  }

  triggers.forEach((trigger, index) => {
    trigger.addEventListener('click', () => activate(index));
    trigger.addEventListener('keydown', (event) => {
      let newIndex = index;
      if (event.key === 'ArrowRight') newIndex = (index + 1) % triggers.length;
      if (event.key === 'ArrowLeft') newIndex = (index - 1 + triggers.length) % triggers.length;
      if (newIndex !== index) {
        event.preventDefault();
        activate(newIndex);
        triggers[newIndex].focus();
      }
    });
  });
</script>
