---
import type { SiteData } from '../types';

interface Props {
  site: SiteData;
  crossLink?: { href: string; label: string };
}

const { site, crossLink } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="mt-auto border-t border-neutral-200 bg-white">
  <div class="max-w-xl lg:max-w-5xl mx-auto px-4 py-6 text-center text-xs text-neutral-500 flex flex-col gap-2">
    {
      crossLink && (
        <a href={crossLink.href} class="font-semibold text-brand-600">
          {crossLink.label}
        </a>
      )
    }
    <a href="/guide" class="font-semibold text-brand-600">
      {site.uiText.footerGuideLinkText}
    </a>
    <p>© {year} {site.name}. Liens affiliés Amazon — voir mentions ci-dessus.</p>
  </div>
</footer>
