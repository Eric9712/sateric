---
// Corps de page partagé par toutes les vitrines (accueil et /<slug>), pour
// qu'elles restent strictement identiques visuellement par construction —
// une seule définition, jamais deux copies qui pourraient diverger.
import { getCollection } from 'astro:content';
import Header from './Header.astro';
import SiteSwitcher from './SiteSwitcher.astro';
import FeaturedProduct from './FeaturedProduct.astro';
import TabsIdeaLists from './TabsIdeaLists.astro';
import ShoppablePhoto from './ShoppablePhoto.astro';
import Footer from './Footer.astro';
import ProductListSchema from './ProductListSchema.astro';
import type { CollectionEntry } from 'astro:content';
import { productRedirectSlug } from '../lib/redirectSlug.mjs';

interface Props {
  vitrine: CollectionEntry<'vitrines'>;
  switcherSites: { id: string; name: string; href: string; avatar: string; active: boolean }[];
}

const { vitrine, switcherSites } = Astro.props;
const site = vitrine.data;
const hasSwitcher = switcherSites.length > 1;

const lists = (await getCollection('lists', (l) => l.data.vitrine === vitrine.id)).sort(
  (a, b) => a.data.order - b.data.order
);
const photos = (await getCollection('photos', (p) => p.data.vitrine === vitrine.id)).sort(
  (a, b) => a.data.order - b.data.order
);

// Un seul produit vedette : le premier trouvé, tous statuts confondus
// (produits directs puis sous-idées, dans l'ordre des listes).
let featured: { product: (typeof lists)[number]['data']['products'][number]; listId: string; listTitle: string } | null = null;
for (const list of lists) {
  const direct = list.data.products.find((p) => p.featured);
  if (direct) {
    featured = { product: direct, listId: list.id, listTitle: list.data.title };
    break;
  }
  for (const sub of list.data.subIdeas) {
    const nested = sub.products.find((p) => p.featured);
    if (nested) {
      featured = { product: nested, listId: list.id, listTitle: `${list.data.title} — ${sub.title}` };
      break;
    }
  }
  if (featured) break;
}
---

<ProductListSchema site={site} lists={lists} photos={photos} />
{hasSwitcher && <SiteSwitcher sites={switcherSites} />}
<div class:list={hasSwitcher && 'lg:pl-52'}>
  <Header site={site} />

  <main>
    {
      featured && (
        <FeaturedProduct
          site={site}
          title={featured.product.title}
          badge={featured.product.badge}
          price={featured.product.price}
          originalPrice={featured.product.originalPrice}
          image={featured.product.image}
          affiliateUrl={`/aller/${productRedirectSlug(featured.listId, featured.product.title)}`}
          listTitle={featured.listTitle}
        />
      )
    }
    <TabsIdeaLists site={site} lists={lists} />

    <section aria-labelledby="shoppable-heading" class="px-4 pb-6">
      <div class="max-w-xl lg:max-w-5xl mx-auto rounded-3xl bg-gradient-to-br from-accent-400/10 to-brand-100/40 p-4 lg:p-6 shadow-sm ring-1 ring-black/5">
        <h2 id="shoppable-heading" class="mb-3 flex items-center gap-2 text-lg font-extrabold text-ink-900">
          <span class="h-5 w-1.5 rounded-full bg-gradient-to-b from-brand-500 to-accent-500" aria-hidden="true" />
          {site.uiText.shoppablePhotosHeading}
        </h2>
        <p class="mb-3 text-sm text-neutral-600">{site.uiText.shoppablePhotosSubtitle}</p>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
          {photos.map((photo) => (
            <ShoppablePhoto site={site} photo={photo} />
          ))}
        </div>
      </div>
    </section>
  </main>

  <Footer site={site} qrHref={`/qr/${vitrine.id}.svg`} />
</div>
