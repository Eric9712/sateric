---
interface Props {
  title: string;
  price: number;
  image: string;
  affiliateUrl: string;
  listTitle: string;
  isStarterProduct?: boolean;
}

const { title, price, image, affiliateUrl, listTitle, isStarterProduct = false } = Astro.props;
const priceLabel = new Intl.NumberFormat('fr-FR', { style: 'currency', currency: 'EUR' }).format(price);
---

<article class="group relative flex flex-col overflow-hidden rounded-3xl border border-neutral-100 bg-white shadow-md transition-shadow hover:shadow-xl">
  {
    isStarterProduct && (
      <span class="absolute top-3 left-3 z-10 inline-flex items-center gap-1 rounded-full bg-gradient-to-r from-brand-600 to-accent-600 px-3 py-1.5 text-sm font-bold text-white shadow-md">
        🔥 Coup de cœur
      </span>
    )
  }
  <div class="overflow-hidden bg-neutral-50">
    <img
      src={image}
      alt={title}
      width="600"
      height="600"
      loading="lazy"
      decoding="async"
      class="aspect-square w-full object-cover transition-transform duration-300 group-hover:scale-105"
    />
  </div>
  <div class="flex flex-1 flex-col gap-1.5 p-4">
    <h3 class="text-base font-bold text-ink-900 line-clamp-2">{title}</h3>
    <p class="text-2xl font-extrabold text-brand-600">{priceLabel}</p>
    <p class="text-xs text-neutral-500">Lien affilié</p>
    <a
      href={affiliateUrl}
      target="_blank"
      rel="sponsored noopener"
      data-product-click
      data-product-title={title}
      data-list-title={listTitle}
      data-product-price={price}
      class="tap-target mt-3 inline-flex w-full items-center justify-center rounded-full bg-gradient-to-r from-brand-600 to-accent-600 px-4 py-3.5 text-base font-bold text-white shadow-sm transition-transform active:scale-95"
    >
      Voir le prix sur Amazon
    </a>
  </div>
</article>

<script>
  // Suivi de clic par produit via Cloudflare Zaraz (si activé sur le projet).
  // Ne fait rien si Zaraz n'est pas encore configuré : voir le guide de déploiement.
  document.addEventListener('click', (event) => {
    const target = (event.target as HTMLElement)?.closest<HTMLElement>('[data-product-click]');
    if (!target) return;
    const w = window as typeof window & { zaraz?: { track: (name: string, props?: Record<string, unknown>) => void } };
    w.zaraz?.track('product_click', {
      product: target.dataset.productTitle,
      list: target.dataset.listTitle,
      price: target.dataset.productPrice,
    });
  });
</script>
