---
import site from '../data/site.json';

interface Props {
  title: string;
  price: number;
  originalPrice?: number;
  image: string;
  affiliateUrl: string;
  listTitle: string;
  isStarterProduct?: boolean;
}

const { title, price, originalPrice, image, affiliateUrl, listTitle, isStarterProduct = false } = Astro.props;

// Sans accès Creators API (ex-PA-API), afficher un prix saisi à la main est
// interdit par l'Operating Agreement Amazon Partenaires (le prix affiché doit
// venir d'un appel API en temps réel, jamais d'une valeur mise en cache/fixe).
// showPrices reste à false tant que cet accès n'est pas en place — voir
// site.json et le guide de déploiement.
const showPrices = site.showPrices === true;

const priceLabel = new Intl.NumberFormat('fr-FR', { style: 'currency', currency: 'EUR' }).format(price);
const hasDiscount = showPrices && typeof originalPrice === 'number' && originalPrice > price;
const originalPriceLabel = hasDiscount
  ? new Intl.NumberFormat('fr-FR', { style: 'currency', currency: 'EUR' }).format(originalPrice)
  : null;
const discountPercent = hasDiscount ? Math.round((1 - price / originalPrice) * 100) : null;
---

<!--
  Toute la carte est le lien (comme une grille de résultats Amazon) : à 3
  colonnes, un bouton texte séparé ne tiendrait pas. La cible tactile est donc
  la carte entière (largement > 44x44px), conforme WCAG.
-->
<a
  href={affiliateUrl}
  target="_blank"
  rel="sponsored noopener"
  data-product-click
  data-product-title={title}
  data-list-title={listTitle}
  data-product-price={price}
  class="group relative flex flex-col overflow-hidden rounded-2xl border border-neutral-100 bg-white shadow-sm transition-all hover:shadow-lg active:scale-[0.97]"
>
  {
    isStarterProduct && (
      <span class="absolute top-1.5 left-1.5 z-10 flex h-6 w-6 items-center justify-center rounded-full bg-gradient-to-br from-brand-600 to-accent-600 text-xs shadow-md">
        <span aria-hidden="true">🔥</span>
        <span class="sr-only">{site.uiText.starterBadgeLabel}</span>
      </span>
    )
  }
  {
    hasDiscount && (
      <span class="absolute top-1.5 right-1.5 z-10 rounded-full bg-ink-900 px-1.5 py-0.5 text-[10px] font-extrabold text-white shadow-md">
        -{discountPercent}%
      </span>
    )
  }
  <div class="overflow-hidden bg-neutral-50">
    <img
      src={image}
      alt={title}
      width="400"
      height="400"
      loading="lazy"
      decoding="async"
      class="aspect-square w-full object-cover transition-transform duration-300 group-hover:scale-105"
    />
  </div>
  <div class="flex flex-1 flex-col gap-0.5 p-2">
    <h3 class="text-[11px] font-semibold leading-tight text-ink-900 line-clamp-2">{title}</h3>
    {
      showPrices ? (
        <div class="mt-auto flex flex-wrap items-baseline gap-x-1.5 pt-1">
          <span class="text-sm font-extrabold text-brand-600">{priceLabel}</span>
          {hasDiscount && <span class="text-[10px] text-neutral-400 line-through">{originalPriceLabel}</span>}
        </div>
      ) : (
        <p class="mt-auto pt-1 text-[11px] font-bold text-brand-600">{site.uiText.priceHiddenCta}</p>
      )
    }
    <p class="text-[9px] text-neutral-400">{site.uiText.affiliateLinkLabel}</p>
  </div>
</a>

<script>
  // Suivi de clic par produit via Cloudflare Zaraz (si activé sur le projet).
  // Ne fait rien si Zaraz n'est pas encore configuré : voir le guide de déploiement.
  document.addEventListener('click', (event) => {
    const target = (event.target as HTMLElement)?.closest<HTMLElement>('[data-product-click]');
    if (!target) return;
    const w = window as typeof window & { zaraz?: { track: (name: string, props?: Record<string, unknown>) => void } };
    let source: string | null = null;
    try {
      source = sessionStorage.getItem('trafficSource');
    } catch {
      // sessionStorage indisponible : on suit quand même le clic, juste sans la source.
    }
    w.zaraz?.track('product_click', {
      product: target.dataset.productTitle,
      list: target.dataset.listTitle,
      price: target.dataset.productPrice,
      source: source ?? 'direct',
    });
  });
</script>
