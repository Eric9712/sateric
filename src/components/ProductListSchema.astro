---
// Données structurées Schema.org (Product / ItemList) pour Google. On
// n'inclut le prix (Offer) que si showPrices est actif, pour ne jamais
// marquer un prix qui ne serait pas affiché à l'écran (règle Google : les
// données structurées doivent correspondre au contenu visible). Pas de
// note/avis (Review, AggregateRating) : aucun avis n'est réellement
// collecté sur ce site, en inventer serait une pratique commerciale
// trompeuse (même principe que le champ "Étiquette" des produits).
import type { SiteData } from '../types';

interface Product {
  title: string;
  image: string;
  price: number;
}

interface Props {
  site: SiteData;
  lists: { products: Product[]; subIdeas: { products: Product[] }[] }[];
  photos: { image: string; hotspots: { title: string; price: number }[] }[];
}

const { site, lists, photos } = Astro.props;

const items: { name: string; image: string; price: number }[] = [];

for (const list of lists) {
  for (const p of list.products) items.push({ name: p.title, image: p.image, price: p.price });
  for (const sub of list.subIdeas) {
    for (const p of sub.products) items.push({ name: p.title, image: p.image, price: p.price });
  }
}
for (const photo of photos) {
  for (const h of photo.hotspots) items.push({ name: h.title, image: photo.image, price: h.price });
}

const pageUrl = Astro.url.href;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  itemListElement: items.map((item, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    item: {
      '@type': 'Product',
      name: item.name,
      image: new URL(item.image, Astro.site).href,
      url: pageUrl,
      ...(site.showPrices
        ? {
            offers: {
              '@type': 'Offer',
              price: item.price,
              priceCurrency: 'EUR',
              url: pageUrl,
            },
          }
        : {}),
    },
  })),
};
---

<script type="application/ld+json" set:html={JSON.stringify(schema)} />
