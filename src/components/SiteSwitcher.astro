---
// Colonne verticale permettant de basculer entre les vitrines : cliquer sur
// le titre d'une vitrine y amène directement. Sur mobile (pas assez de
// place pour une vraie colonne latérale), s'affiche en bloc vertical pleine
// largeur tout en haut de la page ; à partir de lg:, devient une colonne
// fixe sur le bord gauche de l'écran.
interface Props {
  sites: { name: string; href: string; active: boolean }[];
}

const { sites } = Astro.props;
---

<nav
  aria-label="Changer de vitrine"
  class="border-b border-neutral-200 bg-ink-900 px-4 py-3 lg:fixed lg:inset-y-0 lg:left-0 lg:w-52 lg:border-b-0 lg:border-r lg:px-4 lg:py-6"
>
  <div class="flex flex-col gap-1">
    {
      sites.map((s) =>
        s.active ? (
          <span
            aria-current="page"
            class="rounded-full bg-gradient-to-r from-brand-600 to-accent-600 px-4 py-2 text-left text-sm font-bold text-white shadow-sm"
          >
            {s.name}
          </span>
        ) : (
          <a
            href={s.href}
            class="tap-target rounded-full px-4 py-2 text-left text-sm font-semibold text-white/70 transition-colors hover:bg-white/10 hover:text-white"
          >
            {s.name}
          </a>
        )
      )
    }
  </div>
</nav>
