---
// Barre tout en haut de page permettant de basculer entre les vitrines :
// cliquer sur le titre d'une vitrine y amène directement.
interface Props {
  sites: { name: string; href: string; active: boolean }[];
}

const { sites } = Astro.props;
---

<nav aria-label="Changer de vitrine" class="bg-ink-900">
  <div class="max-w-xl lg:max-w-5xl mx-auto flex justify-center gap-2 px-4 py-2">
    {
      sites.map((s) =>
        s.active ? (
          <span
            aria-current="page"
            class="rounded-full bg-gradient-to-r from-brand-600 to-accent-600 px-4 py-1.5 text-sm font-bold text-white shadow-sm"
          >
            {s.name}
          </span>
        ) : (
          <a
            href={s.href}
            class="tap-target rounded-full px-4 py-1.5 text-sm font-semibold text-white/70 transition-colors hover:bg-white/10 hover:text-white"
          >
            {s.name}
          </a>
        )
      )
    }
  </div>
</nav>
