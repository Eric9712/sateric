---
import type { CollectionEntry } from 'astro:content';
import type { SiteData } from '../types';
import { hotspotRedirectSlug } from '../lib/redirectSlug.mjs';

interface Props {
  site: SiteData;
  photo: CollectionEntry<'photos'>;
}

const { site, photo: photoEntry } = Astro.props;
const { title, image, imageWidth, imageHeight, hotspots } = photoEntry.data;
const photoId = photoEntry.id;
const showPrices = site.showPrices === true;
const formatPrice = (n: number) => new Intl.NumberFormat('fr-FR', { style: 'currency', currency: 'EUR' }).format(n);
// Marge de sécurité : une pastille tout au bord (0 ou 100 %) se ferait
// à moitié couper par l'angle arrondi de la photo — on la garde toujours
// entièrement visible et cliquable, quelle que soit la position saisie.
const clampPercent = (n: number) => Math.min(94, Math.max(6, n));
---

<figure class="w-full overflow-hidden rounded-2xl bg-neutral-100 shadow-md ring-1 ring-black/5">
  {/* Positionnement des pastilles calculé sur cette zone (juste la photo),
      pas sur toute la <figure> qui inclut aussi la légende en dessous. */}
  <div class="relative">
    <img
      src={image}
      alt={title}
      width={imageWidth}
      height={imageHeight}
      loading="lazy"
      decoding="async"
      class="block w-full h-auto"
    />

    {
      hotspots.map((h, i) => (
        <div class="absolute" style={`left:${clampPercent(h.x)}%; top:${clampPercent(h.y)}%; transform: translate(-50%, -50%);`}>
        <button
          type="button"
          class="tap-target relative flex items-center justify-center rounded-full bg-white/90 shadow-lg ring-2 ring-brand-500"
          aria-expanded="false"
          aria-controls={`hotspot-panel-${photoId}-${i}`}
          aria-label={`Voir le produit : ${h.title}`}
          data-hotspot-trigger
        >
          <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-brand-500 opacity-40" />
          <span class="relative text-brand-600 font-bold" aria-hidden="true">
            +
          </span>
        </button>

        <div
          id={`hotspot-panel-${photoId}-${i}`}
          role="dialog"
          aria-label={h.title}
          hidden
          data-hotspot-panel
          class="absolute z-20 left-1/2 mt-2 w-44 -translate-x-1/2 rounded-xl border border-neutral-100 bg-white p-3 text-left shadow-xl"
        >
          <p class="text-xs font-semibold text-ink-900">{h.title}</p>
          {showPrices && <p class="text-sm font-bold text-brand-600">{formatPrice(h.price)}</p>}
          <a
            href={`/aller/${hotspotRedirectSlug(photoId, h.title)}`}
            target="_blank"
            rel="sponsored nofollow noopener"
            data-product-click
            data-product-title={h.title}
            data-list-title={`Photo : ${title}`}
            data-product-price={h.price}
            class="tap-target mt-2 flex items-center justify-center rounded-full bg-gradient-to-r from-brand-600 to-accent-600 px-2 py-1.5 text-xs font-bold text-white shadow-sm transition-transform active:scale-95"
          >
            {site.uiText.shoppableCta}
          </a>
          <p class="mt-1 text-[10px] text-neutral-500">{site.uiText.affiliateLinkLabel}</p>
        </div>
      </div>
    ))
    }
  </div>
  <figcaption class="bg-white px-3 py-2 text-sm font-semibold text-ink-900">{title}</figcaption>
</figure>

<script>
  function closeAllPanels(except?: HTMLElement) {
    document.querySelectorAll<HTMLElement>('[data-hotspot-panel]').forEach((panel) => {
      if (panel === except) return;
      panel.hidden = true;
      const trigger = document.querySelector<HTMLElement>(`[aria-controls="${panel.id}"]`);
      trigger?.setAttribute('aria-expanded', 'false');
    });
  }

  document.addEventListener('click', (event) => {
    const target = event.target as HTMLElement;
    const trigger = target.closest<HTMLButtonElement>('[data-hotspot-trigger]');

    if (trigger) {
      const panel = document.getElementById(trigger.getAttribute('aria-controls') ?? '');
      if (panel) {
        const willOpen = panel.hidden;
        closeAllPanels();
        panel.hidden = !willOpen;
        trigger.setAttribute('aria-expanded', String(willOpen));
      }
      return;
    }

    if (!target.closest('[data-hotspot-panel]')) {
      closeAllPanels();
    }
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') closeAllPanels();
  });
</script>
