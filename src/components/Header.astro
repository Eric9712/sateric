---
import LegalBanner from './LegalBanner.astro';
import site from '../data/site.json';

// Icônes génériques (pas les logos officiels) + couleur de marque par réseau.
// Toute plateforme non listée ici (champ libre dans /admin) retombe sur
// genericSocialStyle plus bas — jamais une icône vide.
const socialStyle: Record<string, { icon: string; class: string }> = {
  Instagram: {
    class: 'bg-gradient-to-br from-[#f9ce34] via-[#ee2a7b] to-[#6228d7]',
    icon: '<path d="M12 8.5a3.5 3.5 0 1 0 0 7 3.5 3.5 0 0 0 0-7Z"/><rect x="4" y="4" width="16" height="16" rx="5"/><circle cx="16.2" cy="7.8" r="0.6" fill="currentColor" stroke="none"/>',
  },
  TikTok: {
    class: 'bg-neutral-900',
    icon: '<path d="M14 4v9.5a2.75 2.75 0 1 1-2.5-2.74"/><path d="M14 4c.4 2.2 2 3.7 4 4v2.2c-1.5 0-3-.5-4-1.4"/>',
  },
  YouTube: {
    class: 'bg-[#ff0000]',
    icon: '<rect x="3" y="6" width="18" height="12" rx="4"/><path d="M11 9.5v5l4.2-2.5-4.2-2.5Z" fill="currentColor" stroke="none"/>',
  },
  Facebook: {
    class: 'bg-[#1877f2]',
    icon: '<path d="M14 9h-2a1 1 0 0 0-1 1v2h3l-.4 3H11v6" fill="none"/>',
  },
  Pinterest: {
    class: 'bg-[#e60023]',
    icon: '<circle cx="12" cy="10" r="5.5"/><path d="M12 10c0 3.5-1.5 8-3 10" stroke-linecap="round"/>',
  },
  'X (Twitter)': {
    class: 'bg-black',
    icon: '<path d="M6 6l12 12M18 6L6 18" stroke-linecap="round"/>',
  },
  Snapchat: {
    class: 'bg-[#fffc00] text-black',
    icon: '<rect x="5" y="5" width="14" height="14" rx="7"/><circle cx="9.5" cy="11" r="1" fill="currentColor" stroke="none"/><circle cx="14.5" cy="11" r="1" fill="currentColor" stroke="none"/>',
  },
  Twitch: {
    class: 'bg-[#9146ff]',
    icon: '<rect x="5" y="5" width="14" height="12" rx="2"/><path d="M9 9v4M13 9v4" stroke-linecap="round"/>',
  },
};

// Plateforme tapée librement, non reconnue ci-dessus : icône générique de lien,
// jamais un cercle vide.
const genericSocialStyle = {
  class: 'bg-gradient-to-br from-brand-500 to-accent-600',
  icon: '<path d="M9 15l6-6" stroke-linecap="round"/><path d="M8 12a3 3 0 0 1 0-4.2l2-2a3 3 0 0 1 4.2 4.2" stroke-linecap="round"/><path d="M16 12a3 3 0 0 1 0 4.2l-2 2a3 3 0 0 1-4.2-4.2" stroke-linecap="round"/>',
};
---

<header class="border-b border-neutral-100 bg-white">
  <LegalBanner />

  <div class="max-w-xl lg:max-w-5xl mx-auto px-4 py-4">
    <div class="flex items-center gap-4">
      <img
        src={site.avatar}
        alt={`Photo de profil de ${site.name}`}
        width="64"
        height="64"
        class="h-16 w-16 shrink-0 rounded-full ring-2 ring-brand-100 object-cover"
        loading="eager"
      />
      <div class="min-w-0 flex-1">
        <h1 class="truncate text-lg font-extrabold text-ink-900">{site.name}</h1>
        <p class="truncate text-sm font-semibold text-brand-600">{site.handle}</p>
      </div>
      {
        site.socials.length > 0 && (
          <nav class="flex shrink-0 gap-2" aria-label="Réseaux sociaux">
            {site.socials.map((s) => {
              const style = socialStyle[s.platform] ?? genericSocialStyle;
              return (
                <a
                  href={s.url}
                  target="_blank"
                  rel="noopener"
                  class={`tap-target inline-flex h-9 w-9 items-center justify-center rounded-full text-white transition-transform active:scale-90 ${style.class}`}
                  aria-label={s.platform}
                >
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={style.icon} />
                </a>
              );
            })}
          </nav>
        )
      }
    </div>
    <!-- Ligne dédiée, jamais tronquée : c'est la phrase qui dit à quoi sert le site. -->
    <p class="mt-2 text-sm font-medium text-neutral-700">{site.tagline}</p>
  </div>
</header>
