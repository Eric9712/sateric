---
// Mentions légales obligatoires : loi influenceurs 2023 (DGCCRF) + conditions
// du programme Amazon Partenaires. Éditable via /admin (avec avertissement) :
// "Collaboration commerciale" et le texte de bénéfice sont des formulations
// imposées, à ne pas remplacer par "ad"/"collab"/"partner" etc.
import type { SiteData } from '../types';

interface Props {
  site: SiteData;
}

const { site } = Astro.props;
---

<div class="relative z-10 w-full bg-disclosure-bg shadow-sm">
  <div class="max-w-xl lg:max-w-5xl mx-auto px-4 py-1.5 flex flex-wrap items-center justify-center gap-x-2 gap-y-0.5 text-center">
    <span
      class="inline-flex shrink-0 items-center gap-1 rounded-full bg-disclosure-border/25 px-2 py-0.5 text-[11px] font-bold text-disclosure-text"
    >
      <span aria-hidden="true">📢</span>
      {site.uiText.legalBadge}
    </span>
    <p class="text-[11px] text-disclosure-text leading-tight">
      {site.uiText.legalDisclosure}
    </p>
  </div>
</div>
