---
// Lien affilié "propre" (ex. /aller/canne-moulinet--fil-de-peche-nylon-100m)
// au lieu d'exposer directement l'URL Amazon brute. Redirection statique
// (meta-refresh + JS) : fonctionne à l'identique en local, en preview et en
// production, sans dépendre d'une fonctionnalité propre à un hébergeur.
// noindex : cette page n'est qu'un relais, elle ne doit pas être indexée.
import { getCollection } from 'astro:content';
import { productRedirectSlug, hotspotRedirectSlug } from '../../lib/redirectSlug.mjs';

export async function getStaticPaths() {
  const paths = [];
  const seen = new Set();

  function addPath(slug, target, title) {
    if (seen.has(slug)) return; // collision de titres : on garde la 1ère occurrence
    seen.add(slug);
    paths.push({ params: { slug }, props: { target, title } });
  }

  const lists = await getCollection('lists');
  for (const list of lists) {
    for (const p of list.data.products) {
      addPath(productRedirectSlug(list.id, p.title), p.affiliateUrl, p.title);
    }
    for (const sub of list.data.subIdeas) {
      for (const p of sub.products) {
        addPath(productRedirectSlug(list.id, p.title), p.affiliateUrl, p.title);
      }
    }
  }

  const photos = await getCollection('photos');
  for (const photo of photos) {
    for (const h of photo.data.hotspots) {
      addPath(hotspotRedirectSlug(photo.id, h.title), h.affiliateUrl, h.title);
    }
  }

  return paths;
}

const { target, title } = Astro.props;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex, nofollow" />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <title>Redirection…</title>
  </head>
  <body>
    <p>
      Redirection vers « {title} » sur Amazon… <a href={target} rel="sponsored nofollow noopener">Cliquez ici si rien ne se passe</a>.
    </p>
    <script define:vars={{ target }}>
      location.replace(target);
    </script>
  </body>
</html>
