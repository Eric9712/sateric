---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import TabsIdeaLists from '../components/TabsIdeaLists.astro';
import ShoppablePhoto from '../components/ShoppablePhoto.astro';
import Footer from '../components/Footer.astro';
import site from '../data/site.json';

const lists = (await getCollection('lists')).sort((a, b) => a.data.order - b.data.order);
const photos = await getCollection('photos');
---

<BaseLayout
  title={`${site.name} — Mes recommandations`}
  description={`Retrouvez toutes les recommandations produits de ${site.name} : matériel, beauté, voyage, maison. Liens affiliés Amazon.`}
>
  <Header />

  <main>
    <TabsIdeaLists lists={lists} />

    <section aria-labelledby="shoppable-heading" class="px-4 pb-6">
      <div class="max-w-xl mx-auto rounded-3xl bg-gradient-to-br from-accent-400/10 to-brand-100/40 p-4 shadow-sm ring-1 ring-black/5">
        <h2 id="shoppable-heading" class="mb-3 flex items-center gap-2 text-lg font-extrabold text-ink-900">
          <span class="h-5 w-1.5 rounded-full bg-gradient-to-b from-brand-500 to-accent-500" aria-hidden="true" />
          En situation
        </h2>
        <p class="mb-3 text-sm text-neutral-600">Touchez les pastilles sur les photos pour voir les produits.</p>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          {photos.map((photo) => <ShoppablePhoto photo={photo} />)}
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
