---
// Page d'accueil = la vitrine avec le plus petit "order" (même convention
// que le tri des listes/photos : "plus petit = affiché en premier"). Pour
// changer la vitrine d'accueil, il suffit de lui donner l'ordre le plus bas
// depuis l'admin (bouton "Réorganiser").
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import VitrinePage from '../components/VitrinePage.astro';

const vitrines = (await getCollection('vitrines')).sort((a, b) => a.data.order - b.data.order);
const home = vitrines[0];
const site = home.data;
---

<BaseLayout title={`${site.name} — Mes recommandations`} description={site.metaDescription} ogImage={site.ogImage}>
  <VitrinePage
    vitrine={home}
    switcherSites={vitrines.map((v) => ({
      name: v.data.name,
      href: v.id === home.id ? '/' : `/${v.id}`,
      active: v.id === home.id,
    }))}
  />
</BaseLayout>
