---
import BaseLayout from '../layouts/BaseLayout.astro';
import CommissionTable from '../components/CommissionTable.astro';
import CopyableTemplate from '../components/CopyableTemplate.astro';
import Footer from '../components/Footer.astro';
import site from '../data/site.json';

const storyTemplate = `📢 Collaboration commerciale
Lien en bio 🔗`;

const reelTemplate = `📢 Collaboration commerciale avec Amazon
[Nom du produit] disponible via le lien dans ma bio 🛒
#Publicite #AmazonPartenaire`;

const youtubeTemplate = `📢 Collaboration commerciale
Cette vidéo contient des liens affiliés Amazon. En tant que Partenaire Amazon, je réalise un bénéfice sur les achats remplissant les conditions requises, sans coût supplémentaire pour vous.

🛒 Produits mentionnés :
- [Nom produit 1] : [lien]
- [Nom produit 2] : [lien]
- [Nom produit 3] : [lien]`;
---

<BaseLayout
  title={`Guide légal & programme Amazon Partenaires — ${site.name}`}
  description="Mécanique des cookies, grille de commissions, règles Amazon Partenaires et cadre légal français (loi influenceurs, DGCCRF) expliqués simplement."
>
  <main class="max-w-xl mx-auto px-4 py-8 flex flex-col gap-10">
    <header class="rounded-2xl bg-gradient-to-br from-brand-50 to-accent-400/10 p-5">
      <a href="/" class="inline-flex items-center gap-1 text-sm font-semibold text-brand-600">
        <span aria-hidden="true">&larr;</span> Retour à la boutique
      </a>
      <h1 class="mt-2 text-2xl font-extrabold text-ink-900">Guide pratique &amp; réglementation</h1>
      <p class="mt-2 text-sm text-neutral-600">
        Ce que je respecte en tant que Partenaire Amazon, et ce que dit la loi française sur la publicité
        d'influenceurs.
      </p>
    </header>

    <section aria-labelledby="cookies-heading" class="flex flex-col gap-3">
      <h2 id="cookies-heading" class="flex items-center gap-2 text-lg font-extrabold text-ink-900">
        <span class="h-5 w-1.5 rounded-full bg-gradient-to-b from-brand-500 to-accent-500" aria-hidden="true" />
        Mécanique des cookies
      </h2>
      <ul class="flex flex-col gap-2.5 text-sm text-neutral-700">
        <li class="rounded-xl border border-neutral-100 bg-white p-3 shadow-sm">
          <strong class="text-ink-900">Cookie de 24 heures :</strong> commissionnement sur la totalité du panier
          validé durant cette période, même sur des produits hors vitrine.
        </li>
        <li class="rounded-xl border border-neutral-100 bg-white p-3 shadow-sm">
          <strong class="text-ink-900">Extension panier à 90 jours :</strong> la commission est conservée si
          l'article est ajouté au panier sous 24h et validé dans les 89 jours suivants.
        </li>
        <li class="rounded-xl border border-neutral-100 bg-white p-3 shadow-sm">
          <strong class="text-ink-900">Écrasement du cookie :</strong> la commission est attribuée au dernier
          lien d'affiliation cliqué avant le paiement.
        </li>
      </ul>
    </section>

    <section aria-labelledby="commissions-heading" class="flex flex-col gap-3">
      <h2 id="commissions-heading" class="flex items-center gap-2 text-lg font-extrabold text-ink-900">
        <span class="h-5 w-1.5 rounded-full bg-gradient-to-b from-brand-500 to-accent-500" aria-hidden="true" />
        Grille indicative des commissions
      </h2>
      <CommissionTable />
    </section>

    <section aria-labelledby="interdictions-heading" class="flex flex-col gap-3">
      <h2 id="interdictions-heading" class="flex items-center gap-2 text-lg font-extrabold text-ink-900">
        <span class="h-5 w-1.5 rounded-full bg-gradient-to-b from-brand-500 to-accent-500" aria-hidden="true" />
        Règles d'interdiction strictes (Amazon)
      </h2>
      <ul class="flex flex-col gap-2 text-sm text-neutral-700 list-disc list-inside rounded-xl border border-neutral-100 bg-white p-4 shadow-sm">
        <li>Achats personnels ou incitation aux proches/famille : strictement interdits.</li>
        <li>
          Diffusion sur des canaux privés (e-mails privés, newsletters fermées, SMS, groupes Telegram/WhatsApp
          privés) : interdite sans accord formel d'Amazon.
        </li>
      </ul>
    </section>

    <section aria-labelledby="legal-heading" class="flex flex-col gap-3">
      <h2 id="legal-heading" class="flex items-center gap-2 text-lg font-extrabold text-ink-900">
        <span class="h-5 w-1.5 rounded-full bg-gradient-to-b from-brand-500 to-accent-500" aria-hidden="true" />
        Cadre légal français (Loi influenceurs / DGCCRF)
      </h2>
      <p class="text-sm text-neutral-700">
        Mentions obligatoires : <strong class="text-ink-900">« Collaboration commerciale »</strong> ou <strong class="text-ink-900">« Publicité »</strong>. Les formulations imprécises comme <em>ad</em>, <em>collab</em> ou <em>partner</em> seules sont interdites.
      </p>
      <ul class="flex flex-col gap-2 text-sm text-neutral-700 list-disc list-inside">
        <li>Vidéos/stories : incrustation permanente tout au long de la séquence.</li>
        <li>Textes/descriptions : mention au tout début du texte, sans nécessité de cliquer sur « Voir plus ».</li>
      </ul>
      <p class="text-sm text-neutral-700">
        Mises en garde : respect strict des contrastes texte/fond (mention parfaitement lisible), interdiction de
        masquer l'origine du lien derrière des réducteurs d'URL non explicites.
      </p>
    </section>

    <section aria-labelledby="templates-heading" class="flex flex-col gap-3">
      <h2 id="templates-heading" class="flex items-center gap-2 text-lg font-extrabold text-ink-900">
        <span class="h-5 w-1.5 rounded-full bg-gradient-to-b from-brand-500 to-accent-500" aria-hidden="true" />
        Modèles de mentions prêts à l'emploi
      </h2>
      <div class="flex flex-col gap-3">
        <CopyableTemplate label="Story" text={storyTemplate} />
        <CopyableTemplate label="Reel / TikTok / Short" text={reelTemplate} />
        <CopyableTemplate label="Description YouTube (longue)" text={youtubeTemplate} />
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
