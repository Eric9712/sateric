---
// Deuxième vitrine, indépendante de la page d'accueil : son propre nom, sa
// propre description, ses propres listes/photos, gérés séparément dans
// l'admin ("Vitrine 2 : ..."). Même structure de page que l'accueil.
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import TabsIdeaLists from '../../components/TabsIdeaLists.astro';
import ShoppablePhoto from '../../components/ShoppablePhoto.astro';
import Footer from '../../components/Footer.astro';
import site from '../../data/site2.json';
import site1 from '../../data/site.json';

const lists = (await getCollection('lists2')).sort((a, b) => a.data.order - b.data.order);
const photos = (await getCollection('photos2')).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout
  title={`${site.name} — Mes recommandations`}
  description={site.metaDescription}
  ogImage={site.ogImage}
>
  <Header site={site} />

  <main>
    <TabsIdeaLists site={site} lists={lists} />

    <section aria-labelledby="shoppable-heading" class="px-4 pb-6">
      <div class="max-w-xl lg:max-w-5xl mx-auto rounded-3xl bg-gradient-to-br from-accent-400/10 to-brand-100/40 p-4 lg:p-6 shadow-sm ring-1 ring-black/5">
        <h2 id="shoppable-heading" class="mb-3 flex items-center gap-2 text-lg font-extrabold text-ink-900">
          <span class="h-5 w-1.5 rounded-full bg-gradient-to-b from-brand-500 to-accent-500" aria-hidden="true" />
          {site.uiText.shoppablePhotosHeading}
        </h2>
        <p class="mb-3 text-sm text-neutral-600">{site.uiText.shoppablePhotosSubtitle}</p>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
          {photos.map((photo) => <ShoppablePhoto site={site} photo={photo} />)}
        </div>
      </div>
    </section>
  </main>

  <Footer site={site} crossLink={{ href: '/', label: `Découvrir : ${site1.name} →` }} />
</BaseLayout>
